        "    times = dataFrame['Time'].values\n",
        "    eegData = dataFrame.iloc[:, 1:].values.T\n",
        "    channels = dataFrame.columns[1:].tolist()\n",
        "\n",
        "    fileInfo = mne.create_info(ch_names=channels, sfreq=sampleRate, ch_types='eeg')\n",
        "    rawEeg = mne.io.RawArray(eegData, fileInfo)\n",
        "\n",
