        "      ends = events[events[:, 2] == EVENT_VIDEO_END]\n",
        "\n",
        "      if len(starts) != len(ends):\n",
        "          print(f\"Error: Mismatch in video start/end event counts ({len(starts)} starts, {len(ends)} ends).\")\n",
        "\n",
        "      minLength = min(len(starts), len(ends))\n",
        "\n",
        "      for i in range(minLength):\n",
