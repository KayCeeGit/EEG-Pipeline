    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "from scipy.fft import rfft, rfftfreq\n",
        "\n",
        "class FeatureExtractorV3:\n",
        "    def __init__(self, samplingRate):\n",
        "      self.samplingRate = samplingRate\n",
        "      self.bands = {   #from national library of medicine: https://www.ncbi.nlm.nih.gov/books/NBK539805/   SETTING POTENTIAL\n",
        "        'delta': (0.5, 4),\n",
        "        'theta': (4, 7),\n",
        "        'alpha': (7, 12),\n",
        "        'beta':  (12, 30),\n",
        "        'gamma': (30, 80)\n",
        "      }\n",
        "\n",
        "    def get_band_powers_over_time(self, data, window_size_sec=1.0, overlap=0.5):\n",
        "      \"\"\"\n",
        "      Calculate band powers over sliding windows on 1D data (one channel).\n",
        "      Returns:\n",
        "          times: list of window start times (seconds)\n",
        "          band_powers: dict {band_name: list of power values per window}\n",
        "      \"\"\"\n",
        "      step_size = int(window_size_sec * self.samplingRate * (1 - overlap))\n",
        "      window_len = int(window_size_sec * self.samplingRate)\n",
        "      n_windows = (len(data) - window_len) // step_size + 1\n",
        "\n",
        "      times = []\n",
        "      band_powers = {band: [] for band in self.bands}\n",
        "\n",
        "      for w in range(n_windows):\n",
        "          start = w * step_size\n",
        "          end = start + window_len\n",
        "          window_data = data[start:end]\n",
        "\n",
        "          if len(window_data) < window_len:\n",
        "              continue\n",
        "\n",
        "          # Compute FFT power spectrum\n",
        "          yf = np.abs(rfft(window_data)) ** 2\n",
        "          xf = rfftfreq(len(window_data), 1 / self.samplingRate)\n",
        "\n",
        "          # Sum power in each band\n",
        "          for band, (low, high) in self.bands.items():\n",
        "              idx = np.where((xf >= low) & (xf <= high))\n",
        "              power = np.sum(yf[idx])\n",
        "              band_powers[band].append(power)\n",
        "\n",
        "          times.append(start / self.samplingRate)\n",
        "\n",
        "      return times, band_powers\n",
        "\n",
        "    def extract_bandpowers_sliding(self, segments, window_size_sec=1.0, overlap=0.5):\n",
        "      all_features = []\n",
        "      all_times = []\n",
        "\n",
        "      for segment_idx, segment in enumerate(segments):\n",
        "          segment_features = None\n",
        "          segment_times = []\n",
        "\n",
        "          for ch in range(segment.shape[0]):\n",
        "              times, band_powers = self.get_band_powers_over_time(segment[ch], window_size_sec, overlap)\n",
        "\n",
        "              bands = list(band_powers.keys())\n",
        "              data = np.vstack([band_powers[b] for b in bands]).T\n",
        "\n",
        "              if segment_features is None:\n",
        "                  segment_features = [dict() for _ in range(len(times))]\n",
        "                  segment_times = times\n",
        "\n",
        "              for i, _ in enumerate(times):\n",
        "                  for b, band in enumerate(bands):\n",
        "                      segment_features[i][f'ch{ch}_{band}'] = data[i, b]\n",
        "\n",
        "          all_features.extend(segment_features)\n",
        "          all_times.extend(segment_times)\n",
        "\n",
        "      return all_features, all_times"
      ],
